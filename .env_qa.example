# ── Concurrency ───────────────────────────────────────────────────────
PER_REPLICA_CONCURRENCY=24
HTTP_MIN_REPLICAS=1
HTTP_MAX_REPLICAS=1
HTTP_SCALE_CONCURRENT_REQUESTS=24

# ── Request status tracking ────────────────────────────────────────────
# Folder used by /assess/status endpoints for active request marker files.
# Leave empty to default to WORKDIR_BASE/active-requests.
ACTIVE_REQUEST_IDS_DIR=

AZURE_OPENAI_ENDPOINT=https://your-openai-resource.cognitiveservices.azure.com/

AZURE_OPENAI_DEPLOYMENT="gpt5.4-mini"
#AZURE_OPENAI_DEPLOYMENT_O1="o1"
#AZURE_OPENAI_DEPLOYMENT_O1="gpt-5.1"
#AZURE_OPENAI_DEPLOYMENT_O1="gpt-5.4-1"
AZURE_OPENAI_DEPLOYMENT_O1="o3"

AZURE_OPENAI_ENDPOINT_WKSAN=
AZURE_OPENAI_API_KEY_WKSAN=
AZURE_OPENAI_DEPLOYMENT_WKSAN=gpt-4o

AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

LOG_LEVEL="DEBUG"
AWR_API_ENDPOINT=http://127.0.0.1:8080

# API AUTH mode for engine_core api: "none" or "apikey" or "entra"
AUTH_MODE=entra
#API_KEY=

# ── Resource Reuse Flags ──────────────────────────────────────────────────────
# Set to TRUE to reference an existing resource; FALSE (or omit) to provision new.
AZ_STORAGE_REUSE=FALSE
AZ_APPINSIGHTS_REUSE=TRUE
AZ_KEY_VAULT_REUSE=FALSE
AZ_APIM_ENABLED=FALSE          # skip APIM provisioning entirely in QA
AZ_APIM_REUSE=FALSE            # ignored when AZ_APIM_ENABLED=FALSE
AZ_LOGANALYTICS_REUSE=TRUE
AZ_IDENTITIES_REUSE=FALSE
AZ_ACR_REUSE=TRUE              # reuse existing Container Registry
AZ_CORE_RG_REUSE=FALSE         # deploy new resources into the existing RG
AZ_CONTAINER_APP_ENV_REUSE=FALSE
AZ_CORE_RG_NAME=your-resource-group
AZ_VNET_REUSE=FALSE



# ── VNet Integration (optional) ──────────────────────────────────────────────
# Set AZ_VNET_ENABLED=TRUE to create a VNet-integrated ACA environment.
# When FALSE (default), ACA runs without VNet (Consumption shared outbound IPs).
# NOTE: Changing this requires recreating the ACA environment.
AZ_VNET_ENABLED=TRUE
AZ_VNET_NAME=your-vnet
AZ_VNET_RG=your-shared-resource-group
AZ_VNET_ADDRESS_PREFIX=
AZ_VNET_SUBNET_NAME=your-subnet
AZ_VNET_SUBNET_PREFIX=

# ── Existing Resource Details (required when *_REUSE=TRUE) ────────────────────
# Storage
AZ_STORAGE_NAME=yourstorageaccount
AZ_STORAGE_RG=your-resource-group

# Key Vault
AZ_KEY_VAULT_NAME=
AZ_KEY_VAULT_RG=your-shared-resource-group

# ── Service Bus (Platform → Engine queue-worker dispatch)  - NOT FULLY IMPLEMENTED - DONT USE ─────────────────
# Service Bus (Platform ↔ Engine async dispatch — high-volume KEDA queue-worker mode) - NOT FULLY IMPLEMENTED - DONT USE
AZ_SERVICE_BUS_REUSE=TRUE
AZ_SERVICE_BUS_NAME=DUMMY
AZ_SERVICE_BUS_RG=your-shared-resource-group
# SB_NAMESPACE is consumed by runtime/config.py and passed to
# ServiceBusClient(fully_qualified_namespace=...), so it MUST be the FQDN.
# SbConnection__fullyQualifiedNamespace is read by the Azure Functions SB
# trigger binding (connection="SbConnection") to authenticate via MI.
# Both must point to the same namespace.
SB_NAMESPACE=
SB_RUNS_QUEUE=
SB_RESULTS_QUEUE=
ENGINE_REPORT_MODE=
SbConnection__fullyQualifiedNamespace=
# ── Queue Worker ACA Deployment Defaults ─────────────────────────────────────
SB_QUEUE=${SB_RUNS_QUEUE}
SB_NAMESPACE_NAME=${SB_NAMESPACE%.servicebus.windows.net}
REPORT_MODE=${ENGINE_REPORT_MODE}
BLOB_ACCOUNT_URL=https://${AZ_STORAGE_NAME}.blob.core.windows.net
BLOB_RESULTS_CONTAINER=results
BLOB_RESULTS_PREFIX=runs
PLATFORM_API_BASE_URL=
PLATFORM_AUDIENCE=
APIM_AOAI_BASE_URL=
AOAI_DEPLOYMENT=${AZURE_OPENAI_DEPLOYMENT_O1}
AOAI_API_VERSION=${AZURE_OPENAI_API_VERSION}
# Queue-worker specific concurrency to avoid overriding http-service setting.
QUEUE_WORKER_PER_REPLICA_CONCURRENCY=4
ACTIVE_REQUEST_IDS_DIR=/work/active-requests
AWREASON_CLI_TIMEOUT=300
AWREASON_MAX_RETRIES=3
AWREASON_RETRY_BACKOFF=10
OTEL_EXPORTER_OTLP_ENDPOINT=
PLATFORM_CONTRACT_URL=
ALLOW_REUSE_RESOURCE_MUTATIONS=FALSE
QUEUE_WORKER_MIN_REPLICAS=3
QUEUE_WORKER_MAX_REPLICAS=50
QUEUE_WORKER_POLLING_INTERVAL=5
QUEUE_WORKER_COOLDOWN_PERIOD=120
QUEUE_WORKER_MESSAGE_COUNT=1

# ── Container App Deployment ──────────────────────────────────────────────────
AZ_LOCATION=northeurope
AZ_ACR_NAME=yourContainerRegistry
AZ_ACR_RG=your-shared-resource-group
AZ_CONTAINER_APP_ENV_NAME=your-container-app-environment
AZ_CONTAINER_APP_ENV_RG=your-resource-group
AZ_CONTAINER_APP_NAME=your-http-service
AZ_CONTAINER_APP_NAME_Q_WORKER=your-queue-worker
AZ_IMAGE_TAG=latest

# AOAI resource (for Managed Identity role assignment)
AZ_AOAI_RESOURCE_NAME=your-openai-resource
AZ_AOAI_RESOURCE_RG=your-shared-resource-group

# Streamlit Entra ID Auth (App Registration)
AAD_CLIENT_ID=00000000-0000-0000-0000-000000000000
AAD_CLIENT_SECRET=
AAD_TENANT_ID=00000000-0000-0000-0000-000000000000
AAD_APP_DISPLAY_NAME=your-streamlit-app

# Managed Identity
AZ_MI_NAME=your-managed-identity

# Application Insights
AZ_APPINSIGHTS_NAME=your-application-insights
AZ_APPINSIGHTS_RG=your-shared-resource-group

# Log Analytics Workspace
AZ_LOGANALYTICS_NAME=your-log-analytics-workspace
AZ_LOGANALYTICS_RG=your-shared-resource-group

AZURE_AI_ENDPOINT="https://your-foundry-resource.services.ai.azure.com/"
AZ_MI_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZ_MI_RESOURCE_ID=/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/your-resource-group/providers/Microsoft.ManagedIdentity/userAssignedIdentities/your-managed-identity
AZ_MI_PRINCIPAL_ID=00000000-0000-0000-0000-000000000000


AAD_REQUIRED_SCOPE=access_as_user
AAD_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
AAD_AUDIENCE=00000000-0000-0000-0000-000000000000
AAD_REQUIRED_APP_ROLE=YourApp.Access
AAD_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
AAD_API_APP_DISPLAY_NAME=your-api-app
AAD_API_APP_ROLE_ID=00000000-0000-0000-0000-000000000000
AAD_API_SCOPE_ID=00000000-0000-0000-0000-000000000000

STREAMLIT_E2E_USERNAME=

# The follwing are Optional Variables only required when using the RAG components of this repo
AZURE_OPENAI_ENDPOINT_WCGSAN=
AZURE_OPENAI_API_KEY_WCGSAN=
AZURE_OPENAI_DEPLOYMENT_WCGSAN=

AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-3-large"
# API Version: Use 2025-03-01-preview for GPT-5.x models, 2024-12-01-preview for O1/O3
AZURE_OPENAI_API_VERSION="2025-03-01-preview"

AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_SERVICE=
AZURE_AI_SEARCH_INDEX=
AZURE_AI_SERVICES_ENDPOINT=
AZURE_AI_API_VERSION="2024-12-01-preview"

SEARCH_QUERY_CONFIG="{col_header}  Question number  {row_header}"