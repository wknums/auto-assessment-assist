# ══════════════════════════════════════════════════════════════════════
#  awreason HTTP Service – example environment variables
# ══════════════════════════════════════════════════════════════════════
#
#  Copy this file to `.env` and fill in the values.
#  **Never commit .env files with real secrets.**
# ══════════════════════════════════════════════════════════════════════

# ── General ───────────────────────────────────────────────────────────
APP_NAME=awreason-http-service
LOG_LEVEL=INFO

# ── Working directory ─────────────────────────────────────────────────
# In ACA this is an EmptyDir volume.  Locally use any writable path.
WORKDIR_BASE=/work

# ── Concurrency ───────────────────────────────────────────────────────
PER_REPLICA_CONCURRENCY=1

# ── Azure Blob Storage ────────────────────────────────────────────────
# Auth: Managed Identity (MI) – no SAS tokens.
AZ_STORAGE_NAME=<your-storage-account>
AZ_STORAGE_RG=<your-resource-group>
BLOB_CONTAINER_RESULTS=results
BLOB_CONTAINER_UPLOADS=uploads

# ── Azure OpenAI (direct – used when APIM is not configured) ─────────
AZURE_OPENAI_ENDPOINT=https://<your-aoai-resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=         # Only if NOT using MI auth.  Prefer Entra ID.

# ── APIM AI Gateway (optional – takes priority over direct AOAI) ────
APIM_AOAI_BASE_URL=https://<your-apim>.azure-api.net/openai/v1
AOAI_DEPLOYMENT=o1
AOAI_API_VERSION=2024-12-01-preview
USE_AAD_FOR_AOAI=true

# ── Auth ─────────────────────────────────────────────────────────────
# AUTH_MODE controls how the API authenticates incoming requests:
#   "none"   – no auth, open access (local dev only)
#   "apikey" – shared secret via X-Api-Key header (test / staging)
#   "entra"  – Entra ID JWT bearer token validation (production)
AUTH_MODE=none

# API key (required when AUTH_MODE=apikey).
# Callers send this value in the X-Api-Key header.
# They also send X-User-Id and X-User-Role to identify the user/role.
# API_KEY=<generate-a-strong-random-secret>

# Entra ID settings (required when AUTH_MODE=entra).
# AAD_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# AAD_AUDIENCE=api://<your-app-registration-client-id>

# ── Azure Identity ───────────────────────────────────────────────────
AZURE_TENANT_ID=<your-tenant-id>
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
# AZURE_CLIENT_ID=              # Set on ACA via the managed identity

# ── awreason engine ──────────────────────────────────────────────────
AWREASON_CLI_CMD=awreason.py
AWREASON_CLI_TIMEOUT=300
AWREASON_MAX_RETRIES=3
AWREASON_RETRY_BACKOFF=10

# ── Telemetry (OpenTelemetry – OTLP export) ──────────────────────────
# Leave empty to disable OTel.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=awreason-http-service

# ── Aggregation ──────────────────────────────────────────────────────
DEFAULT_AGGREGATION_METHOD=median

# ── Streamlit UX Entra ID auth (only needed when deployed on Azure) ──
# These enable Microsoft sign-in on the Streamlit frontend.
# Locally the UX is unauthenticated.
# AAD_CLIENT_ID=<app-registration-client-id>
# AAD_CLIENT_SECRET=<app-registration-client-secret>
# AAD_TENANT_ID is reused from AZURE_TENANT_ID above

# ── Internal API endpoint (used by Streamlit to call the API) ────────
# In a single container this is localhost; in sidecar mode use the FQDN.
AWR_API_ENDPOINT=http://localhost:8080
